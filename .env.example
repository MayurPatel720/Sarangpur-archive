# Copy to .env.local and adjust for your machine.

# Connection string for the MongoDB started by docker-compose.yml.
# authSource=admin is required because the root user lives in the admin database.
MONGODB_URI=mongodb://archive:archive_dev_password@localhost:27017/archive_tracker?authSource=admin

# Alert thresholds, in days. These drive the "Alerts & escalations" panel.
ALERT_DECISION_PENDING_DAYS=5
ALERT_SCAN_STUCK_DAYS=10

# Total capacity of the archive volume, in terabytes. Shown in the sidebar meter.

# Secret for signing Auth.js session tokens. Generate one with `openssl rand -base64 32`.
AUTH_SECRET=change-me-to-a-random-string

# Dev-only password stamped onto every generated seed user by `npm run seed`.
# Real accounts are created with `npx tsx scripts/create-user.ts`.
SEED_DEV_PASSWORD=archive-dev-123

# Where photos are stored. Normally set in the app (Admin -> Settings -> Photo storage); these two are only the fallback.
# Where photos are stored. `cloudinary` (default) uses the credentials below; `disk` keeps them on this server in MEDIA_ROOT
# (a local folder or a network path such as \\sarangpur.net\ps\app-photos) and serves them through /api/media after a login check.
# Thumbnails are made on demand and cached in MEDIA_ROOT/.cache. The account the app runs as needs read + write on MEDIA_ROOT.
STORAGE_DRIVER=cloudinary
MEDIA_ROOT=

# Cloudinary credentials for project photos (src/server/projects/images.ts). From the
# Cloudinary console: Dashboard -> API Keys. Optional: without them photo uploads answer
# 503 and everything else keeps working. Never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
