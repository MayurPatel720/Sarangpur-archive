# Copy to .env.local and adjust for your machine.

# Connection string for the MongoDB started by docker-compose.yml.
# authSource=admin is required because the root user lives in the admin database.
MONGODB_URI=mongodb://archive:archive_dev_password@localhost:27017/archive_tracker?authSource=admin

# Alert thresholds, in days. These drive the "Alerts & escalations" panel.
ALERT_DECISION_PENDING_DAYS=5
ALERT_SCAN_STUCK_DAYS=10

# Total capacity of the archive volume, in terabytes. Shown in the sidebar meter.
ARCHIVE_STORAGE_CAPACITY_TB=96
