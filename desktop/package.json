{
  "name": "sarangpur-archive-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Sarangpur Archive in its own window. Dropping a file or folder fills in its full path.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-packager . \"Sarangpur Archive\" --platform=win32 --arch=x64 --icon=assets/icon.ico --out=dist --overwrite --prune=true --ignore=^/dist --ignore=^/make-icon --ignore=^/README.md",
    "installer": "npm run dist && electron-builder --win nsis --prepackaged \"dist/Sarangpur Archive-win32-x64\""
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.sarangpur.archive.desktop",
    "productName": "Sarangpur Archive",
    "directories": {
      "output": "dist-installer"
    },
    "artifactName": "Sarangpur-Archive-Setup.${ext}",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
