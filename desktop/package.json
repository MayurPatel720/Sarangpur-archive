{
  "name": "archive-tracker-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Archive Tracker in its own window. Dropping a file or folder fills in its full path.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.sarangpur.archive.desktop",
    "productName": "Archive Tracker",
    "files": ["main.js", "preload.js", "package.json"],
    "win": { "target": "portable" }
  }
}
